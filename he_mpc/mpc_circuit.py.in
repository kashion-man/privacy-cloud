# Generated only from public operation/shape specifications. MP-SPDZ compiler input.
from Compiler.types import sint, sfix, Array, regint
from Compiler.library import for_range, print_ln_to
from Compiler import mpc_math

sfix.set_precision(F, 41)
sfix.round_nearest = True
program.use_edabit(True)


def input_vector(scale):
    a = sint.get_input_from(0, size=N)
    b = sint.get_input_from(1, size=N)
    total = a + b
    total = (total.greater_equal(T, bit_length=61)).if_else(total-T, total)
    total = (total.greater_than(T//2, bit_length=60)).if_else(total-T, total)
    if scale > F:
        total = total.round(k=60, m=scale-F, nearest=True, signed=True)
    elif scale < F:
        total *= 2**(F-scale)
    return sfix._new(total)


xs = [input_vector(s) for s in SCALES]
if OP == 'identity':
    ys = [xs[0]]
elif OP == 'mul':
    ys = [xs[0] * xs[1]]
elif OP == 'norm':
    assert GROUP > 0 and GROUP & (GROUP-1) == 0 and N % GROUP == 0
    gamma = sfix._new(sint.get_input_from(0, size=GROUP))
    x = Array.create_from(xs[0])
    y = Array(N, sfix)
    scaled = Array(N, sfix)
    variances = Array(N//GROUP, sfix)
    for g in range(N//GROUP):
        z = x[g*GROUP:(g+1)*GROUP]
        # Qwen's residual stream has large outlier features. A secret branch
        # rescales the whole group before squaring; the choice is never opened.
        # With HE's public scale-28 range, scaled squares fit sfix(20,41).
        large = (((z > 256) + (z < -256)).sum() > 0)
        z = large.expand_to_vector(GROUP).if_else(z * (1.0/128), z)
        epsilon = large.if_else(sfix(EPS/(128*128)), sfix(EPS))
        # Sum unreduced INTEGER products and truncate once. A long group can
        # exceed sfix's ordinary intermediate sum width even when its mean fits.
        group_bits = GROUP.bit_length()-1
        squares = sint.dot_product(z.v, z.v)
        mean_raw = squares.round(k=2*41+group_bits, m=F+group_bits,
                                 nearest=True, signed=False)
        variances[g] = sfix._new(mean_raw) + epsilon
        scaled[g*GROUP:(g+1)*GROUP] = z
    # All heads take part in one vector square-root/division circuit. This is
    # the same per-head RMSNorm, without serializing independent network rounds.
    inverses = Array.create_from(1.0 / mpc_math.sqrt(variances[:]))
    for g in range(N//GROUP):
        y[g*GROUP:(g+1)*GROUP] = scaled[g*GROUP:(g+1)*GROUP] * inverses[g] * gamma
    ys = [y[:]]
elif OP == 'silu':
    # Securely clamp only the sigmoid input. Outside this interval SiLU's
    # absolute approximation error is below 0.003 for |x| <= 64.
    x = xs[0]
    z = (x < -10).if_else(sfix(-10), x)
    z = (z > 10).if_else(sfix(10), z)
    exp_minus = mpc_math.exp2_fx(-z * 1.4426950408889634)
    ys = [x / (1 + exp_minus)]
elif OP == 'softmax':
    maximum = xs[0]
    for x in xs[1:]:
        maximum = (x > maximum).if_else(x, maximum)
    values = []
    for x in xs:
        z = x - maximum
        z = (z < -12).if_else(sfix(-12), z)
        values.append(mpc_math.exp2_fx(z * 1.4426950408889634))
    denominator = sum(values)
    ys = [x / denominator for x in values]
elif OP == 'argmax':
    # Parallel comparison tournament. Only the final encrypted one-hot result
    # leaves MPC. Ties select the lowest vocabulary index.
    values = Array.create_from(sfix.concat(xs))
    count = VOCAB
    indices = Array(count, sint)
    @for_range(count)
    def _(i):
        indices[i] = i
    while count > 1:
        half = count//2
        left = values[0:2*half:2]
        right = values[1:2*half:2]
        choose = right > left
        next_values = Array((count+1)//2, sfix)
        next_indices = Array((count+1)//2, sint)
        next_values[:half] = choose.if_else(right, left)
        next_indices[:half] = choose.if_else(indices[1:2*half:2], indices[0:2*half:2])
        if count % 2:
            next_values[half] = values[count-1]
            next_indices[half] = indices[count-1]
        values, indices = next_values, next_indices
        count = (count+1)//2
    selected = indices[0]
    # Keep one packed vector for each public ciphertext block.
    ys = []
    for block in range(len(xs)):
        ids = sint(regint.inc(N, block*N, 1))
        # Equality already yields a nonnegative bit. Encode at the public
        # BFV output scale directly, preserving the same masked residues.
        ys.append((selected.expand_to_vector(N) == ids) * (2**OUT_F))
else:
    raise ValueError('Unsupported MPC operation')

for y in ys:
    if OP == 'argmax':
        raw = y
    else:
        raw = y.v
        if F > OUT_F:
            raw = raw.round(k=41, m=F-OUT_F, nearest=True, signed=True)
        raw = (raw < 0).if_else(raw + T, raw)
    mask = sint.get_input_from(0, size=N)
    share = raw - mask
    share = (share < 0).if_else(share + T, share)
    # This is a uniformly masked output share, never an unmasked activation.
    revealed = Array.create_from(share.reveal_to(1)._v)
    @for_range(N)
    def _(i):
        print_ln_to(1, 'S %s', revealed[i])

